# Copy to .env; generate a token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NAPAR_BRIDGE_TOKEN=replace-with-a-random-token-of-at-least-32-characters
NAPAR_DATABASE=data/napar.db
NAPAR_LLM_BACKEND=disabled
# Only enable after configuring a provider and checking your spending limit.
NAPAR_LLM_MODEL=gpt-4o-mini
NAPAR_LLM_BASE_URL=https://api.openai.com/v1
NAPAR_LLM_API_KEY=
NAPAR_MAX_CALLS_PER_DAY=120
NAPAR_MAX_STEPS=6
NAPAR_MAX_OUTPUT_TOKENS=700
NAPAR_OWNER_NAME=
NAPAR_INITIATIVE_SECONDS=0
